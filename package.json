{
  "name": "pkqa-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-mc-data.mjs && next build",
    "mc:data": "node scripts/generate-mc-data.mjs",
    "check:mc": "node scripts/verify-mc-commands.mjs",
    "check:expanded": "node scripts/verify-mc-expanded.mjs",
    "check:potion": "node scripts/verify-mc-potion.mjs",
    "check:player": "node scripts/verify-player-lookup.mjs",
    "check:audit": "node scripts/verify-mc-audit.mjs && node scripts/verify-mc-interactions.mjs",
    "check:deep": "node scripts/verify-mc-deep.mjs",
    "check:third": "node scripts/verify-mc-third-pass.mjs",
    "check:fourth": "node scripts/verify-mc-fourth-pass.mjs",
    "check:fifth": "node scripts/verify-mc-fifth-pass.mjs",
    "check:sixth": "node scripts/verify-mc-sixth-pass.mjs",
    "check:seventh": "node scripts/verify-mc-seventh-items.mjs && node scripts/verify-mc-seventh-network.mjs && node scripts/verify-mc-seventh-text-entity.mjs && node scripts/verify-mc-seventh-targets.mjs && node scripts/verify-mc-seventh-inputs.mjs",
    "check:launch": "node scripts/verify-mc-server-launch.mjs && node scripts/verify-mc-server-launch-ui.mjs",
    "check:launch:native": "node scripts/verify-mc-server-launch-native.mjs && node scripts/verify-mc-server-launch-shell.mjs",
    "check:native": "node scripts/verify-mc-native.mjs",
    "start": "next start",
    "lint": "eslint",
    "check:sizing": "node scripts/verify-mc-server-sizing.mjs && node scripts/verify-mc-server-sizing-independent.mjs && node scripts/verify-mc-server-sizing-ui.mjs"
  },
  "dependencies": {
    "framer-motion": "^13.4.1",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "minecraft-data": "^3.117.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.19.0"
}
